/* 底部留出吸底栏的空间（含安全区），保证最后一项内容不被遮住 */
.page { padding-bottom: 220rpx; }

/* 顶部：背景图 + 渐变遮罩 */
.hero {
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 56rpx 40rpx 80rpx;
  background: #1D4ED8;
  border-radius: 0 0 32rpx 32rpx;
}
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.12) 0%, rgba(0,0,0,0.26) 60%, rgba(0,0,0,0.46) 100%);
}
.hero-body { position: relative; z-index: 1; }
.hero-eyebrow {
  display: inline-block; font-size: 22rpx; letter-spacing: 1rpx;
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: rgba(255,255,255,0.18); border: 2rpx solid rgba(255,255,255,0.24);
}
.hero-title { margin-top: 18rpx; font-size: 44rpx; font-weight: 700; line-height: 1.3; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.25); }
.hero-sub { margin-top: 14rpx; font-size: 26rpx; color: rgba(255,255,255,0.88); line-height: 1.6; }

.card {
  margin: -40rpx 24rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.field { margin-bottom: 28rpx; }
.label { font-size: 28rpx; font-weight: 600; color: #1f2329; margin-bottom: 12rpx; }
.req { color: #DC2626; margin-left: 6rpx; }
.opt { color: #94A3B8; font-size: 22rpx; font-weight: 400; margin-left: 10rpx; }

.input {
  height: 88rpx;
  background: #f6f7f9;
  border: 2rpx solid #eceef1;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.input:focus { border-color: #2563EB; }
.ph { color: #b3b8c0; }

.wx-phone {
  margin-top: 12rpx;
  background: #eaf1ff;
  color: #2563EB;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0;
  height: 72rpx;
  line-height: 72rpx;
}
.wx-phone::after { border: none; }

.tags { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f6f7f9;
  color: #64748B;
  font-size: 26rpx;
  border: 2rpx solid #eceef1;
}
.tag-on {
  background: #eaf1ff;
  color: #2563EB;
  border-color: #2563EB;
  font-weight: 600;
}

.textarea {
  width: 100%;
  min-height: 140rpx;
  background: #f6f7f9;
  border: 2rpx solid #eceef1;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.privacy { font-size: 22rpx; color: #94A3B8; line-height: 1.5; margin: 8rpx 0 4rpx; }

/* ---------- 吸底提交栏 ---------- */
.footer-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 30;
  background: #fff;
  padding: 14rpx 24rpx 14rpx;
  padding-bottom: calc(14rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 24rpx rgba(15, 23, 42, 0.08);
}
.footer-inner { display: flex; align-items: center; }
.footer-sum {
  flex: 1; font-size: 24rpx; color: #2563EB;
}
.submit {
  flex: 3;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
}
.submit.disabled { opacity: 0.6; }

/* 成功态 */
.done-card { text-align: center; padding-bottom: 40rpx; }
.done-icon {
  width: 96rpx; height: 96rpx; line-height: 96rpx;
  border-radius: 50%; background: #e8f7ee; color: #0f9d58;
  font-size: 48rpx; font-weight: 700; margin: 8rpx auto 20rpx;
}
.done-title { font-size: 36rpx; font-weight: 700; }
.done-desc { margin-top: 12rpx; font-size: 26rpx; color: #64748B; line-height: 1.7; }
.qr-label { margin-top: 32rpx; font-size: 26rpx; color: #1f2329; }
.qr { width: 320rpx; margin: 16rpx auto 0; border-radius: 12rpx; display: block; }

.done-actions { display: flex; gap: 20rpx; margin-top: 36rpx; }
.btn-ghost, .btn-solid { flex: 1; height: 84rpx; line-height: 84rpx; border-radius: 999rpx; font-size: 28rpx; }
.btn-ghost { border: 2rpx solid #e0e3e8; color: #333; box-sizing: border-box; }
.btn-solid { background: #2563EB; color: #fff; }
