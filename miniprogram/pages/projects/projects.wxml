<view class="container">
  <view class="login-tip" wx:if="{{needLogin}}">
    <text>登录后查看您的服务项目</text>
    <view class="btn-primary" bindtap="goLogin">去登录</view>
  </view>

  <view class="p-list" wx:else>
    <view class="p-item" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
      <view class="p-head">
        <text class="p-name">{{item.name}}</text>
        <text class="p-status">{{item.statusText}}</text>
      </view>
      <view class="p-meta">
        <text class="muted">编号 {{item.projectNo || '—'}}</text>
      </view>
      <view class="p-meta">
        <text>{{item.packageName || '服务项目'}}</text>
      </view>
      <view class="p-meta" wx:if="{{item.startAt}}">
        <text class="muted">{{item.startAt}} ~ {{item.endAt || ''}}</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{!loading && !needLogin && !list.length}}">暂无项目</view>
  <view class="loading" wx:if="{{loading}}">加载中...</view>
</view>
