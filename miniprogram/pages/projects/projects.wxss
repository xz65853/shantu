.login-tip { text-align: center; padding: 120rpx 40rpx; }
.login-tip text { display: block; color: #94A3B8; margin-bottom: 32rpx; }
.p-list { display: flex; flex-direction: column; gap: 16rpx; }
.p-item {
  background: #fff; border: 1rpx solid #E6EAF2; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.1);
}
.p-head { display: flex; justify-content: space-between; align-items: center; }
.p-name { font-size: 30rpx; font-weight: 600; color: #0B1220; }
.p-status { font-size: 22rpx; padding: 8rpx 18rpx; border-radius: 999rpx; background: #EFF4FF; color: #2563EB; }
.p-meta { margin-top: 8rpx; font-size: 26rpx; color: #64748B; }
.loading, .empty { text-align: center; padding: 40rpx; color: #94A3B8; }
