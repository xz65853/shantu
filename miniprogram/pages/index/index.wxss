.page { padding-bottom: 40rpx; }

/* 首屏：背景图 + 渐变遮罩（本地图只能通过 <image> 绝对定位铺底） */
.hero {
  position: relative;
  overflow: hidden;
  color: #fff;
  padding: 64rpx 40rpx 72rpx;
  background: #1f2329;
  border-radius: 0 0 32rpx 32rpx;
}
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.02) 0%, rgba(0,0,0,0.28) 62%, rgba(0,0,0,0.5) 100%);
}
.hero-body { position: relative; z-index: 1; }
.hero-eyebrow {
  display: inline-block; font-size: 22rpx; letter-spacing: 1rpx;
  padding: 6rpx 18rpx; border-radius: 999rpx;
  background: rgba(255,255,255,0.14); border: 2rpx solid rgba(255,255,255,0.18);
  color: rgba(255,255,255,0.92);
}
.hero-title { margin-top: 20rpx; font-size: 48rpx; font-weight: 700; line-height: 1.25; text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.28); }
.hero-sub { margin-top: 16rpx; font-size: 28rpx; color: rgba(255,255,255,0.82); }
.hero-badges { margin-top: 24rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.badge { background: rgba(255,255,255,0.15); padding: 8rpx 20rpx; border-radius: 30rpx; font-size: 24rpx; }
.hero-btn {
  margin-top: 36rpx; display: inline-block; background: #2563EB;
  padding: 20rpx 44rpx; border-radius: 28rpx; font-size: 30rpx; font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.4);
}
.hero-btn-press { transform: scale(0.96); opacity: 0.92; }

/* 数据概览：同后台工作台「待办中心」统计卡 */
.stat-bar { display: flex; gap: 16rpx; padding: 24rpx 24rpx 0; }
.stat-card {
  flex: 1;
  background: #fff;
  border: 1rpx solid #E6EAF2;
  border-radius: 20rpx;
  padding: 22rpx 12rpx;
  text-align: center;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.12);
}
.stat-num { font-size: 36rpx; font-weight: 700; color: #2563EB; letter-spacing: -1rpx; }
.stat-label { margin-top: 6rpx; font-size: 22rpx; color: #64748B; }
.stat-press { transform: scale(0.97); opacity: 0.9; }
.stat-card-cta { background: linear-gradient(150deg, #EFF4FF, #fff); }
.stat-card-cta .stat-num { color: #1D4ED8; }

/* 快捷入口宫格 */
.quick-grid {
  display: flex;
  gap: 8rpx;
  margin: 20rpx 24rpx 0;
  background: #fff;
  border: 1rpx solid #E6EAF2;
  border-radius: 24rpx;
  padding: 24rpx 8rpx;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 16rpx 40rpx -24rpx rgba(11, 18, 32, 0.12);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.quick-name { font-size: 24rpx; color: #0B1220; margin-top: 4rpx; }
.quick-press { opacity: 0.7; transform: scale(0.96); }

.section { padding: 24rpx; }
.section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.section-title { font-size: 34rpx; font-weight: 600; letter-spacing: -0.5rpx; color: #0B1220; }
.section-more { font-size: 26rpx; color: #64748B; }

/* 核心服务：JS 按行分组，每行固定两列（不依赖 flex-wrap/gap/calc，全机型一致） */
.service-row { display: flex; }
.service-row + .service-row { margin-top: 20rpx; }
.service-item {
  flex: 1;
  min-width: 0;
  background: #fff; border: 1rpx solid #E6EAF2; border-radius: 20rpx; padding: 26rpx 24rpx; box-sizing: border-box;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.1);
}
.service-item + .service-item { margin-left: 20rpx; }
.service-press { transform: scale(0.97); opacity: 0.92; }
.service-name { font-size: 30rpx; font-weight: 600; display: block; color: #0B1220; }
.service-summary { font-size: 24rpx; color: #64748B; display: block; margin-top: 8rpx; }

.case-list { display: flex; flex-direction: column; gap: 16rpx; }
.case-item {
  display: flex; background: #fff; border: 1rpx solid #E6EAF2; border-radius: 20rpx; overflow: hidden;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.1);
}
.case-cover { width: 200rpx; height: 140rpx; flex-shrink: 0; }
.case-info { padding: 20rpx; display: flex; flex-direction: column; }
.case-title { font-size: 30rpx; font-weight: 600; color: #0B1220; }
.case-summary { font-size: 24rpx; color: #64748B; margin-top: 8rpx; }

.pkg-list { display: flex; flex-direction: column; gap: 16rpx; }
.pkg-item {
  background: #fff; border: 1rpx solid #E6EAF2; border-radius: 20rpx; padding: 26rpx 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.1);
}
.pkg-info { display: flex; justify-content: space-between; align-items: center; }
.pkg-press { transform: scale(0.98); opacity: 0.92; }
.pkg-name { font-size: 30rpx; color: #0B1220; }
.pkg-price { color: #DC2626; font-size: 32rpx; font-weight: 600; }
.pkg-period { font-size: 22rpx; font-weight: 400; color: #64748B; }

/* 免费预约横幅（留资入口） */
.lead-banner {
  margin: 8rpx 24rpx 24rpx;
  padding: 32rpx 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #2563EB, #4f7ff0);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 10rpx 26rpx rgba(37, 99, 235, 0.28);
}
.lb-title { font-size: 30rpx; font-weight: 600; line-height: 1.4; }
.lb-sub { margin-top: 8rpx; font-size: 22rpx; color: rgba(255,255,255,0.82); }
.lb-btn {
  flex-shrink: 0;
  background: #fff;
  color: #2563EB;
  font-size: 28rpx;
  font-weight: 600;
  padding: 16rpx 32rpx;
  border-radius: 999rpx;
}
.lb-btn-press { transform: scale(0.95); opacity: 0.9; }

.loading { text-align: center; padding: 60rpx; color: #94A3B8; }

