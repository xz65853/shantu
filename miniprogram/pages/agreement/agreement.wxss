page { background: #f7f8fa; }
.container { padding: 24rpx 32rpx 80rpx; }

/* 顶部切换 */
.seg { display: flex; background: #eef1f5; border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; }
.seg-item { flex: 1; text-align: center; padding: 18rpx 0; font-size: 28rpx; color: #64748b; border-radius: 12rpx; }
.seg-active { background: #ffffff; color: #2563eb; font-weight: 600; }

/* 文档排版 */
.doc { background: #ffffff; border-radius: 16rpx; padding: 36rpx 32rpx; }
.doc-updated { font-size: 24rpx; color: #94a3b8; margin-bottom: 24rpx; }
.h2 { font-size: 30rpx; font-weight: 600; color: #0f172a; margin: 32rpx 0 12rpx; }
.p { font-size: 27rpx; color: #475569; line-height: 1.75; margin-bottom: 12rpx; text-align: justify; }
.strong { color: #0f172a; font-weight: 600; }

/* 信息清单表格 */
.table { border: 1rpx solid #e2e8f0; border-radius: 12rpx; overflow: hidden; margin: 8rpx 0 20rpx; }
.tr { display: flex; border-bottom: 1rpx solid #e2e8f0; }
.tr:last-child { border-bottom: none; }
.tr-head { background: #f1f5f9; }
.td { padding: 16rpx 12rpx; font-size: 24rpx; color: #475569; line-height: 1.6; flex: 1.1; }
.td-2 { flex: 1.3; }
.td-3 { flex: 2; }
.tr-head .td { font-weight: 600; color: #0f172a; }
