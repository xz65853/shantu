.login-tip { text-align: center; padding: 120rpx 40rpx; }
.login-tip text { display: block; color: #94A3B8; margin-bottom: 32rpx; }
.c-list { display: flex; flex-direction: column; gap: 16rpx; }
.c-item {
  background: #fff; border: 1rpx solid #E6EAF2; border-radius: 20rpx; padding: 24rpx;
  box-shadow: 0 2rpx 4rpx rgba(11, 18, 32, 0.04), 0 14rpx 32rpx -22rpx rgba(11, 18, 32, 0.1);
}
.c-head { display: flex; justify-content: space-between; align-items: center; }
.c-title { font-size: 30rpx; font-weight: 600; color: #0B1220; }
.c-meta { margin-top: 8rpx; font-size: 26rpx; color: #64748B; }
.c-footer { display: flex; justify-content: flex-end; gap: 16rpx; margin-top: 16rpx; }
.c-view-btn { border: 1rpx solid #E6EAF2; color: #0B1220; border-radius: 999rpx; padding: 12rpx 36rpx; font-size: 26rpx; background: #fff; }
.c-dl-btn { background: #2563EB; color: #fff; border-radius: 999rpx; padding: 12rpx 36rpx; font-size: 26rpx; }
.c-dl-btn:active { background: #1D4ED8; }
.c-sign-btn { background: #DC2626; color: #fff; border-radius: 999rpx; padding: 12rpx 36rpx; font-size: 26rpx; }
.disabled { opacity: 0.55; }
.empty, .loading { text-align: center; padding: 40rpx; color: #94A3B8; }
