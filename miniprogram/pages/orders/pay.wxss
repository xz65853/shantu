.pay-card { text-align: center; padding: 60rpx 40rpx; }
.pay-amount { font-size: 64rpx; font-weight: 700; color: #DC2626; }
.pay-label { margin-top: 16rpx; font-size: 28rpx; }
.pay-err { margin-top: 20rpx; font-size: 26rpx; color: #DC2626; }
.pay-retry {
  margin: 24rpx auto 0; width: 240rpx; height: 72rpx; line-height: 72rpx;
  border: 2rpx solid #e0e3e8; border-radius: 999rpx; font-size: 26rpx; color: #333;
}
