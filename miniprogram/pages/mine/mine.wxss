.page { padding: 0 24rpx 24rpx; }

/* ===== 头部：背景图 + 渐变遮罩 ===== */
.hero {
  position: relative;
  overflow: hidden;
  background: #1D4ED8;
  /* 负边距抵消 .page 的左右内边距，让头部与导航栏无缝衔接 */
  margin: 0 -24rpx;
  border-radius: 0 0 40rpx 40rpx;
  padding: 64rpx 40rpx 110rpx;
  color: #fff;
}
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.hero-mask {
  position: absolute; left: 0; top: 0; right: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(0,0,0,0.20) 0%, rgba(0,0,0,0.30) 55%, rgba(0,0,0,0.50) 100%);
}
.hero-body { position: relative; z-index: 1; }

/* 未登录 */
.guest { display: flex; flex-direction: column; align-items: center; }
.guest-tip { margin: 24rpx 0; font-size: 26rpx; color: rgba(255,255,255,0.86); }
.login-btn {
  background: #fff; color: #2563EB; font-size: 28rpx; font-weight: 600;
  padding: 16rpx 60rpx; border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.18);
}
.login-btn-press { transform: scale(0.96); opacity: 0.9; }

/* 已登录 */
.user { display: flex; align-items: center; gap: 24rpx; }
.avatar-ring {
  width: 140rpx; height: 140rpx; border-radius: 50%;
  border: 4rpx solid rgba(255,255,255,0.5);
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box; flex-shrink: 0;
}
.avatar-btn {
  padding: 0; margin: 0; background: transparent; line-height: 1; position: relative;
}
.avatar-btn::after { border: none; }
.avatar-edit-tip {
  position: absolute; bottom: -30rpx; left: 50%; transform: translateX(-50%);
  font-size: 20rpx; color: rgba(255,255,255,0.9); white-space: nowrap;
  background: rgba(0,0,0,0.35); padding: 2rpx 14rpx; border-radius: 999rpx;
}
.avatar { width: 118rpx; height: 118rpx; border-radius: 50%; }
.avatar-placeholder {
  width: 118rpx; height: 118rpx; border-radius: 50%;
  background: linear-gradient(135deg, #DC2626, #ff7a5c);
  color: #fff; font-size: 52rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
}
.user-info { min-width: 0; }
.user-name { font-size: 36rpx; font-weight: 700; }
.user-tags { margin-top: 12rpx; display: flex; gap: 12rpx; }
.utag {
  font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 999rpx;
  background: rgba(255,255,255,0.18); border: 2rpx solid rgba(255,255,255,0.28);
  color: rgba(255,255,255,0.92);
}
.utag-ok { background: #fff; color: #0f9d58; border-color: transparent; font-weight: 600; }

/* ===== 数据概览（压在头部上） ===== */
.stats {
  position: relative; z-index: 2;
  margin: -64rpx 0 20rpx;
  background: #fff; border-radius: 20rpx; padding: 28rpx 0;
  display: flex; box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.08);
}
.stat { flex: 1; text-align: center; }
.stat + .stat { border-left: 2rpx solid #f2f3f5; }
.stat-num { font-size: 40rpx; font-weight: 700; color: #1f2329; }
.stat-label { margin-top: 6rpx; font-size: 24rpx; color: #94A3B8; }

/* ===== 常用功能 ===== */
.card-title { font-size: 30rpx; font-weight: 600; margin-bottom: 8rpx; }
.quick { display: flex; }
.qi { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 16rpx 0 4rpx; font-size: 26rpx; color: #333; }
/* 图标方块与配色已提升到 app.wxss（首页快捷入口复用同一套） */

/* ===== 实名认证 ===== */
.rn { display: flex; align-items: center; gap: 20rpx; }
.rn-body { flex: 1; min-width: 0; }
.rn-title { font-size: 30rpx; font-weight: 600; }
.rn-sub { margin-top: 4rpx; font-size: 22rpx; color: #94A3B8; }
.rn-status { font-size: 24rpx; color: #DC2626; }
.rn-status.ok { color: #0f9d58; }
.arrow { color: #c8ccd2; font-size: 34rpx; }

/* ===== 其他菜单 ===== */
.menu { padding: 0; }
.mi { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; border-bottom: 2rpx solid #f2f3f5; }
.mi:last-child { border-bottom: none; }
.mi-label { flex: 1; font-size: 30rpx; color: #1f2329; }

/* ===== 退出登录 ===== */
.logout {
  margin-top: 40rpx; text-align: center; padding: 26rpx 0;
  background: #fff; border-radius: 20rpx; color: #DC2626; font-size: 30rpx;
}
.safe-space { height: 40rpx; }
